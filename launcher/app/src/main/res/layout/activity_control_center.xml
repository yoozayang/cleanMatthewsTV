<?xml version="1.0" encoding="utf-8"?>
<!-- The control centre (ControlCenterActivity): toggles like a phone's, in a glass panel under the top bar's
     control centre pill, over Home or any app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="105dp"
        android:layout_marginEnd="56dp"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:padding="14dp"
        android:elevation="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="10dp"
            android:text="@string/control_center"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:letterSpacing="0.1" />

        <GridLayout
            android:id="@+id/tiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="false" />
    </LinearLayout>
</FrameLayout>
